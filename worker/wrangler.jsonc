{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "coact-demo",
  "main": "index.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "../work/worker-assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/ws"
    ]
  },
  "vars": {
    "COACT_ALLOWED_ROOMS": "demo"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COACT_ROOMS",
        "class_name": "CoactRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CoactRoom"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "dev": {
    "port": 4175
  },
  "ratelimits": [
    {
      "name": "COACT_JOIN_LIMITER",
      "namespace_id": "31001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
